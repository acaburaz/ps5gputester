FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake ninja-build meson clang-18 llvm-18 llvm-18-dev lld-18 python3 python3-pip python3-yaml python3-numpy \
    python3-pil python3-mako glslang-tools rsync curl zstd make pkg-config \
    wget unzip ca-certificates && python3 -m pip install --break-system-packages "meson>=1.4" && rm -rf /var/lib/apt/lists/*
WORKDIR /work
